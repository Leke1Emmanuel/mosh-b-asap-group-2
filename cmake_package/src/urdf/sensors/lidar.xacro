<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_lidar">

    <!-- Lidar mount: 0.7 x 0.6 x 0.45 box, centered on its own origin -->
    <xacro:property name="lidar_mount_length" value="0.07"/>
    <xacro:property name="lidar_mount_width" value="0.06"/>
    <xacro:property name="lidar_mount_height" value="0.045"/>
    <xacro:property name="lidar_mount_x_off" value="0.05"/>
    <xacro:property name="lidar_radius" value="0.0295"/>
    <xacro:property name="lidar_height" value="0.02"/>

    <xacro:macro name="lidar" params="prefix">
        <link name="lidar_mount_link">
            <visual>
                <geometry>
                    <mesh filename="package://day_7_description/meshes/lidar_mount.stl" scale="${mesh_scale}"/>
                </geometry>
                <origin xyz="0 0 ${lidar_mount_height/2}" rpy="0 0 0"/>
                <material name="black"/>
            </visual>

            <collision>
                <geometry>
                    <box size="${lidar_mount_length} ${lidar_mount_width} ${lidar_mount_height}"/>
                </geometry>
                <origin xyz="0 0 ${lidar_mount_height}" rpy="0 0 0"/>
            </collision>
        </link>

        <!-- Chassis top is at z = 0.5, so the mount's center sits half its height above that: 0.5 + 0.225 -->
        <joint name="base_lidar_joint" type="fixed">
            <parent link="base_link"/>
            <child link="lidar_mount_link"/>
            <origin xyz="${lidar_mount_x_off} 0 ${base_height/2}" rpy="0 0 0"/>
        </joint>

        <!-- Lidar: cylinder radius 0.245, length 0.2, centered on its own origin -->
        <link name="lidar_link">
            <visual>
                <geometry>
                    <mesh filename="package://day_7_description/meshes/lidar.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="blue"/>
            </visual>

            <collision>
                <geometry>
                    <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
                </geometry>
                <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0"/>
            </collision>
        </link>

        <!-- Mount top is 0.225 above its center; the lidar's center sits another half-height (0.1) above that -->
        <joint name="lidar_mount_lidar_joint" type="fixed">
            <parent link="lidar_mount_link"/>
            <child link="lidar_link"/>
            <origin xyz="0 0 ${lidar_mount_height + lidar_height}" rpy="0 0 0"/>
        </joint>  
    </xacro:macro>

</robot>
