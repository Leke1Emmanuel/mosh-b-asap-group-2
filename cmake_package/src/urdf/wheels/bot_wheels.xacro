<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_wheels">

    <xacro:property name="wheel_length" value="0.025" />
    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="castor_radius" value="0.012" />
    <xacro:property name="castor_xoff" value="0.075" />
    
    <xacro:macro name="wheel" params= "prefix reflect">

        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <mesh filename="package://day_7_description/meshes/wheel.stl" scale="${mesh_scale}"/>
                </geometry>
                <origin xyz="0 ${reflect * wheel_length / 2} 0" rpy="0 0 0"/>
                <material name="black"/>
            </visual>

            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 ${reflect * wheel_length / 2} 0" rpy="${pi/2} 0 0"/>
            </collision>
        </link>

        <joint name="base_${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel_link"/>
            <origin xyz="0 ${reflect * base_width / 2} ${base_height / 2}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>

    </xacro:macro>

    <xacro:macro name="castor_wheel" params="prefix reflect">
        <link name="${prefix}_castor_wheel_link">
            <visual>
                <geometry>
                    <mesh filename="package://day_7_description/meshes/caster.stl" scale="${mesh_scale}"/>
                </geometry>
                <origin xyz="0 0 ${-castor_radius}" rpy="0 0 0"/>
                <material name="black"/>
            </visual>

            <collision>
                <geometry>
                    <sphere radius="${castor_radius}"/>
                </geometry>
                <origin xyz="0 0 ${-castor_radius}" rpy="0 0 0"/>
            </collision>
        </link>

        <joint name="base_${prefix}_castor_wheel_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${prefix}_castor_wheel_link"/>
            <origin xyz="${reflect * castor_xoff} 0 0" rpy="0 0 0"/>
        </joint>
    </xacro:macro>


</robot>