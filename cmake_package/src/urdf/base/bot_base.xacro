<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_colors">
    <xacro:property name="base_length" value="0.2"/>
    <xacro:property name="base_width" value="0.2"/>
    <xacro:property name="base_height" value="0.05"/>

    <xacro:macro name="bot_base" params="prefix">

        <!-- Reference frame sitting on the ground -->
        <link name="base_footprint"/>

        <!-- Chassis: 2.0 x 2.0 x 0.5 box, spans 0.25 to 0.75 m above ground (top face at z = 0.5 in base_link) -->
        <link name="base_link">
            <visual>
                <geometry>
                    <mesh filename="package://day_7_description/meshes/chassis.stl" scale="${mesh_scale}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="grey"/>
            </visual>

            <collision>
                <geometry>
                    <box size="${base_length} ${base_width} ${base_height}"/>
                </geometry>
                <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            </collision>
        </link>

        <joint name="base_footprint_joint" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0 0 ${wheel_radius/2}" rpy="0 0 0"/>
        </joint>

    </xacro:macro>

</robot>
